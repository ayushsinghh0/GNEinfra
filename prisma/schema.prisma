// GNE ERP — Phase 1 data model (Vendor Registration).
//
// Designed to be the long-term foundation: later ERP modules (Procurement,
// Inventory, Project, Finance) will reference Vendor records by id / vendorCode.
// Evolve this schema with `npm run db:migrate` — every change is a tracked,
// reversible migration so existing vendor data is never lost.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Lifecycle of a vendor record, from invitation to approval.
enum VendorStatus {
  INVITED // invite emailed, form not yet submitted
  SUBMITTED // vendor completed the form
  UNDER_REVIEW // procurement is reviewing
  APPROVED // approved for use in the ERP (gets a vendorCode)
  REJECTED
}

enum InviteStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

// ── Multi-role user accounts ──────────────────────────────────────────────────
// Replaces the single shared ADMIN_PASSWORD. Every GNE staff member gets their
// own User row; roles control which parts of the ERP they can access.
enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  BD
  SCM
  PROJECT
  FINANCE
  HR
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  tokenVersion       Int       @default(0)
  lastLoginAt        DateTime?
  createdById        String?
  createdBy          User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers       User[]    @relation("UserCreatedBy")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
}

// A single vendor / supplier. Field names mirror the GNE Vendor Registration
// Form. Tax/registration numbers are optional except GST and PAN (mandatory),
// which is enforced at the application layer (see src/lib/validation.ts).
model Vendor {
  id     String       @id @default(cuid())
  status VendorStatus @default(SUBMITTED)

  // ERP vendor code, assigned on approval (e.g. "GNE-V-0001"). Unique when set.
  vendorCode String? @unique

  // ── Company information ──
  companyName       String
  contactPerson     String?
  mobileNumber      String?
  email             String
  address           String?
  state             String?
  country           String?
  pinCode           String?
  website           String?
  dateOfIncorporation DateTime?
  yearsOfService    String?
  annualTurnover    String?

  // ── Category (Service and/or Product) ──
  offersService Boolean @default(false)
  offersProduct Boolean @default(false)
  oemOrDealer   String? // "OEM" | "DEALER" — product vendors

  // ── Statutory / tax registration ──
  gstNo         String? // optional — vendor toggles whether they have GST
  panNo         String? // optional — vendor toggles whether they have PAN
  exciseNo      String?
  tinNo         String?
  vatLstNo      String?
  cstNo         String?
  serviceTaxNo  String?
  msmeNo        String?

  // ── Bank details (cancelled cheque uploaded as a VendorDocument) ──
  bankName          String?
  bankBranchAddress String?
  bankAccountNo     String?
  bankBranchCode    String?
  ifscCode          String?
  swiftCode         String? // required for foreign vendors
  ibanCode          String? // required for foreign suppliers

  // ── ERP posting classification (filled by GNE, not the vendor) ──
  genBusPostingGroup    String?
  exciseBusPostingGroup String?
  natureOfServices      String?
  vendorPostingGroup    String?

  // ── Relations ──
  services       VendorService[]
  documents      VendorDocument[]
  invite         VendorInvite?
  documentRequests DocumentRequest[]
  products       VendorProduct[]
  experiences    VendorExperience[]
  purchaseOrders VendorPurchaseOrder[]
  turnovers      VendorTurnover[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyName])
  @@index([status])
  @@index([gstNo])
}

// A service / supply category the vendor offers, with optional item details.
// One row per selected category (vendors can pick several). Replaces the old
// past-projects list.
model VendorService {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  category String  // e.g. EPC, Module, Cables, Others (see RegistrationForm)
  item     String? // free-text item / material details for this category

  @@index([vendorId])
}

model VendorProduct {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name     String  // product / category supplied
  brand    String? // make / brand
  model    String?
  @@index([vendorId])
}

model VendorExperience {
  id            String @id @default(cuid())
  vendorId      String
  vendor        Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  financialYear String
  clientProject String
  scope         String?
  value         String?
  @@index([vendorId])
}

model VendorPurchaseOrder {
  id       String    @id @default(cuid())
  vendorId String
  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  poNumber String?
  client   String?
  value    String?
  poDate   DateTime?
  @@index([vendorId])
}

model VendorTurnover {
  id            String @id @default(cuid())
  vendorId      String
  vendor        Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  financialYear String
  amount        String
  @@index([vendorId])
}

// Files uploaded with a registration (cancelled cheque, GST cert, PAN, etc.).
// Stored gzip-compressed via the storage driver (local disk or S3); the
// storageKey locates the object. Files are purged a configurable number of days
// after their first download to minimise cloud storage cost — the metadata row
// is kept (purgedAt set) so we always know what was provided.
model VendorDocument {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  docType      String // e.g. CANCELLED_CHEQUE, GST_CERTIFICATE, PAN_CARD, OTHER
  originalName String
  storageKey   String // object key in the storage backend
  mimeType     String?
  originalSize Int? // bytes before compression
  storedSize   Int? // bytes actually stored
  compressed   Boolean @default(false)

  uploadedAt       DateTime  @default(now())
  downloadCount    Int       @default(0)
  firstDownloadedAt DateTime?
  purgeAfter       DateTime? // set on first download; file deleted after this
  purgedAt         DateTime? // when the file was actually deleted from storage

  @@index([vendorId])
  @@index([purgeAfter])
}

// An email invitation carrying a unique token. The vendor opens
// /register/<token> to fill the form. One invite may produce one vendor.
model VendorInvite {
  id        String       @id @default(cuid())
  email     String
  token     String       @unique
  status    InviteStatus @default(PENDING)
  companyHint String?    // optional company name typed by admin when inviting

  vendorId String? @unique
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  sentAt    DateTime  @default(now())
  expiresAt DateTime?
  usedAt    DateTime?

  @@index([email])
  @@index([status])
}

// A request asking a vendor to re-upload one specific document (e.g. the original
// was corrupt). Carries an unguessable single-use token; the vendor opens
// /reupload/<token> to upload the replacement. Mirrors VendorInvite's security model.
enum DocumentRequestStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

model DocumentRequest {
  id       String @id @default(cuid())
  token    String @unique

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // The corrupt document being replaced. Nullable: the file may already be purged
  // by the time the vendor responds, but the request still names a docType.
  documentId String?
  docType    String // e.g. GST_CERTIFICATE — what the vendor must re-upload

  status      DocumentRequestStatus @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime              @default(now())
  fulfilledAt DateTime?

  @@index([vendorId])
  @@index([status])
}

// ── HR Module ─────────────────────────────────────────────────────────────────

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  SICK
  HALF_DAY
  HOLIDAY
  WEEK_OFF
}

model Employee {
  id               String         @id @default(cuid())
  empId            String         @unique
  name             String
  designation      String
  band             String?
  empCategory      String?
  department       String?
  payrollType      String?
  mailId           String?
  location         String?
  emergencyNumber  String?
  bloodGroup       String?
  iCardNo          String?
  dob              DateTime?
  dateOfJoining    DateTime
  offerLetterDate  DateTime?
  leavingDate      DateTime?
  status           EmployeeStatus @default(ACTIVE)
  totalCtc         Int?
  salary           Int?
  lta              Int?
  specialAllowance Int?
  conveyance       Int?

  casualLeaveQuota   Int     @default(12)
  sickLeaveQuota     Int     @default(12)
  bankAccountNo      String?
  bankName           String?
  ifsc               String?
  uan                String?
  panNo              String?
  esicNo             String?

  // Fixed monthly deductions for the structure-based payment slip (₹; managed on /hr/payroll)
  pfDeduction    Int?
  esiDeduction   Int?
  tdsDeduction   Int?
  otherDeduction Int?

  assets             EmployeeAsset[]
  attendance         AttendanceRecord[]
  payrolls           PayrollRecord[]
  projectAssignments ProjectAssignment[]
  familyMembers      EmployeeFamilyMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([location])
  @@index([designation])
}

// Family / next-of-kin members (repeatable per employee). Cascade-deletes with
// the employee — family data has no independent history to protect (unlike
// attendance/payroll, which use Restrict). Nominee fields feed PF/ESIC/gratuity
// paperwork; isDependent flags who is covered for benefits.
model EmployeeFamilyMember {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  relation   String // Father / Mother / Spouse / Son / Daughter / Guardian / Sibling / Other
  dob        DateTime? @db.Date
  gender     String?
  occupation String?
  contact    String?
  isDependent Boolean  @default(false)
  isNominee   Boolean  @default(false)
  nomineePct  Int? // PF/ESIC/gratuity nominee share, when isNominee
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([employeeId])
}

model EmployeeAsset {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hasLaptop  Boolean   @default(false)
  lpSerialNo String?
  makeModel  String?
  lpCategory String?
  oemName    String?
  laptopBag  Boolean   @default(false)
  mouse      Boolean   @default(false)
  charger    Boolean   @default(false)
  idCard     Boolean   @default(false)
  allocatedAt DateTime  @default(now())
  returnedAt  DateTime?

  @@index([employeeId])
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date        DateTime         @db.Date
  status      AttendanceStatus
  note        String?
  enteredById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

model PayrollRecord {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  periodYear  Int
  periodMonth Int
  code        String?
  role        String?
  designation String?
  doj         DateTime?
  ctc         Int?
  basic         Int @default(0)
  hra           Int @default(0)
  cca           Int @default(0)
  personalPay   Int @default(0)
  conveyance    Int @default(0)
  lta              Int @default(0)
  specialAllowance Int @default(0)
  pla           Int @default(0)
  medicalReimb  Int @default(0)
  totalEarnings Int @default(0)
  tds             Int @default(0)
  loanAdv         Int @default(0)
  epf             Int @default(0)
  esi             Int @default(0)
  totalDeductions Int @default(0)
  payableAmount Int @default(0)
  remarks       String?
  extraLines    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

model Project {
  id          String        @id @default(cuid())
  name        String
  code        String        @unique
  client      String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  assignments ProjectAssignment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model ProjectAssignment {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleOnProject String?
  allocationPct Int?
  startDate     DateTime
  endDate       DateTime?
  createdAt     DateTime  @default(now())

  @@unique([employeeId, projectId])
  @@index([employeeId])
  @@index([projectId])
}

// ── Recruitment / Sourcing ────────────────────────────────────────────────────
// JobPosition = the open role (role/position details + JD + manpower requirement);
// Candidate = an applicant sourced against it (sourcing + CV tracker + hiring
// pipeline). See docs/superpowers/specs/2026-07-08-hr-recruitment-module-design.md.
enum PositionStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum HiringStage {
  SOURCED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  ON_HOLD
}

model JobPosition {
  id             String         @id @default(cuid())
  title          String
  code           String?        @unique // optional requisition code, e.g. REQ-0001
  department     String?
  band           String?
  location       String?
  employmentType String? // Full-time / Contract / Intern / Consultant
  openings       Int            @default(1) // Total Manpower Requirement
  jobDescription String? // long-form JD
  status         PositionStatus @default(OPEN)
  candidates     Candidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Candidate {
  id              String       @id @default(cuid())
  name            String
  email           String?
  phone           String?
  positionId      String?
  position        JobPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  source          String? // Referral / Job Portal / Agency / LinkedIn / Walk-in / Other
  stage           HiringStage  @default(SOURCED)
  cvReceived      Boolean      @default(false)
  cvLink          String? // external CV link (no file storage in v1)
  experienceYears Float?
  noticePeriod    String?
  appliedOn       DateTime?    @db.Date
  notes           String?
  hiredEmployeeId String? // set when converted to an Employee (loose link)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([positionId])
  @@index([stage])
}

// ── BD Module ─────────────────────────────────────────────────────────────────
// Mirrors the four sheets of the GNE "BD Tracker" workbook: Client list,
// Query & Quote (enquiry) tracker, PO Received tracker, and yearly Targets.

enum BdServiceType {
  EPC
  OM
  EPC_OM
}

enum BdPlantType {
  GROUND // GBS — ground-based solar
  ROOF // RTS — rooftop solar
  HYBRID
}

// "Stage" column of the Query & Quote tracker — the working pipeline stage.
enum BdStage {
  ENQUIRY
  QUOTE_SUBMITTED
  FOLLOW_UP
  NEGOTIATION
  CLOSED
}

// "Final Status" column — the commercial outcome.
enum BdFinalStatus {
  OPEN
  WON
  LOST
}

// Project-wise categorisation (Solar / BESS × PMC / EPC / I&C / O&M) applied to
// enquiries/quotations, targets and POs. Separate from BdServiceType/BdPlantType
// (the client-master taxonomy) — this is the project-scope category the BD team
// tracks quotations by.
enum BdTechnology {
  SOLAR
  BESS
}

enum BdServiceCategory {
  PMC
  EPC
  INC // Installation & Commissioning (I&C)
  OM // O&M
}

// The quote sub-process status, tracked alongside the pipeline BdStage.
enum BdQuotationStatus {
  PENDING
  QUOTE_PREPARATION
  APPROVAL
  QUOTE_SUBMISSION
}

model BdClient {
  id            String         @id @default(cuid())
  name          String
  industry      String? // e.g. Renewable / Govt / O&M
  serviceType   BdServiceType?
  plantType     BdPlantType?
  contactPerson String?
  contactNumber String?
  notes         String?

  enquiries      BdEnquiry[]
  purchaseOrders BdPurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// One row of the "Query & Quote" (commercial quote submission) tracker.
model BdEnquiry {
  id                String        @id @default(cuid())
  fiscalYear        String // "FY 25-26"
  enquiryDate       DateTime?     @db.Date
  enquiryType       String? // "Type" column (e.g. O&M, EPC, AMC)
  clientId          String
  client            BdClient      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  personName        String?
  contactNo         String?
  location          String?
  projectType       String?
  activities        String?
  unit              String? // kW / MW / Nos …
  qty               Int? // quantity in the unit above (sheet: "Qty ( KW)")
  quoteNo           String?
  submissionDate    DateTime?     @db.Date
  projectStatus     String? // free-text "Status of Project"
  probabilityPct    Int? // 0–100
  forecastedRevenue Int? // integer rupees
  stage             BdStage       @default(ENQUIRY)
  expectedClosure   DateTime?     @db.Date
  finalStatus       BdFinalStatus @default(OPEN)
  customerContact   String?
  value             Int? // quoted value, integer rupees
  notes             String?

  // Project-wise category (replaces free-text projectType in the UI; column kept for history)
  technology      BdTechnology?
  serviceCategory BdServiceCategory?
  // Quotation sub-process (tracked alongside `stage`)
  quotationStatus BdQuotationStatus @default(PENDING)
  submittedTo     String? // whom the quote was submitted to
  quoteValidUntil DateTime?         @db.Date
  quoteRevision   String? // e.g. "R0", "R1"
  // Extra enquiry info
  enquirySource    String? // how the enquiry came in
  nextFollowUpDate DateTime? @db.Date

  purchaseOrders BdPurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([stage])
  @@index([finalStatus])
  @@index([fiscalYear])
}

// One row of the "PO Received" tracker.
model BdPurchaseOrder {
  id            String     @id @default(cuid())
  fiscalYear    String
  receivedDate  DateTime?  @db.Date // sheet "Date" — when the PO landed
  projectType   String?
  clientId      String
  client        BdClient   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  activities    String?
  quoteNo       String?
  enquiryId     String? // optional link back to the winning enquiry
  enquiry       BdEnquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  projectQty    String? // free-text (e.g. "2 MW", "14 sites")
  projectPeriod String?
  poNumber      String? // sheet "PO Received"
  poValue       Int? // integer rupees
  poDate        DateTime?  @db.Date
  poStart       DateTime?  @db.Date
  poEnd         DateTime?  @db.Date
  technology      BdTechnology?
  serviceCategory BdServiceCategory?
  remarks       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([fiscalYear])
}

// One row of the "Target for Year" sheet — a business target line.
model BdTarget {
  id                String         @id @default(cuid())
  fiscalYear        String // "FY 25-26"
  quarter           String? // Q1–Q4
  states            String?
  keyAccountPerson  String?
  project           String?
  serviceType       BdServiceType?
  plantType         BdPlantType?
  projectSize       String? // free-text "Project Size (kW/MW)"
  locations         Int? // "No of Locations"
  estimatedValue    Int? // integer rupees
  probabilityPct    Int? // 0–100
  forecastedRevenue Int? // integer rupees
  orderReceived     Int? // integer rupees actually received
  salesTarget       Int? // the sales target (₹); achievement % = orderReceived / salesTarget
  technology        BdTechnology?
  serviceCategory   BdServiceCategory?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fiscalYear])
}

// ── Finance Module ────────────────────────────────────────────────────────────
// Invoice raise → NOPA (Note On Payment Approval) → oversight sign-off →
// payment marking → reconciliation. Mirrors the GNE Tax Invoice format and
// NOPA sheet; all money is integer rupees, totals recomputed server-side.

enum InvoiceStatus {
  DRAFT // being edited by Finance
  PENDING_APPROVAL // NOPA raised, waiting on Manager/Admin/Superadmin
  APPROVED
  REJECTED // sent back — editable again, resubmit allowed
}

enum PaymentStatus {
  UNPAID
  PAID
}

model Invoice {
  id        String   @id @default(cuid())
  invoiceNo String   @unique // e.g. "GNE/25-26/0001" — suggested, editable while draft
  invoiceDate DateTime @db.Date

  // Order / contact block (top-right of the Tax Invoice format)
  orderNo       String?
  orderDate     DateTime? @db.Date
  contactPerson String?
  contactNumber String?

  // Parties (multi-line address blocks)
  billTo String
  shipTo String?

  // Tax — single GST line per the format ("IGST Amount", 18%)
  gstLabel String @default("IGST")
  gstRate  Int    @default(18) // percent

  // Server-computed totals (integer rupees)
  subtotal  Int @default(0)
  gstAmount Int @default(0)
  total     Int @default(0)

  status InvoiceStatus @default(DRAFT)

  // Payment marking — done by the Finance role after approval
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentDate     DateTime?     @db.Date
  paymentRef      String?
  paymentMarkedBy String? // name of the finance user who marked it

  // Workflow audit trail (loose name strings, matching HR's precedent)
  createdByName   String?
  submittedByName String?
  submittedAt     DateTime?
  decidedByName   String?
  decidedByRole   String?
  decidedAt       DateTime?
  decisionRemarks String?

  notes String?

  items InvoiceItem[]
  nopa  Nopa?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([invoiceDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  sacCode     String?
  qty         Float   @default(1)
  uom         String?
  rate        Int     @default(0) // integer rupees per unit
  amount      Int     @default(0) // server-computed round(qty × rate)
  sortOrder   Int     @default(0)

  @@index([invoiceId])
}

// Note On Payment Approval — one per invoice, created when Finance submits the
// invoice for approval. Pre-filled from the invoice, every field editable.
model Nopa {
  id        String  @id @default(cuid())
  invoiceId String  @unique
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  nopaNo   String   @unique // e.g. "NOPA/25-26/0001"
  nopaDate DateTime @db.Date

  companyName     String  @default("Green Next Energy Infra Pvt Ltd")
  plantName       String?
  partyName       String? // sheet "Vendor Name" — the payee / party
  itemDescription String?
  poRef           String? // "PO/WO Reference No"

  gstRate     Int @default(18) // percent
  basicAmount Int @default(0) // server-computed from lines
  gstAmount   Int @default(0)
  grandTotal  Int @default(0)

  advancePaid    Int       @default(0) // "Advance 1st Payment Paid"
  advanceRequest Int       @default(0) // "Request for Advance Payment"
  dueDate        DateTime? @db.Date

  // Payee bank details
  bankName    String?
  accountNo   String?
  ifsc        String?
  branchName  String?

  initiatedBy String?
  checkedBy   String?

  lines NopaLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NopaLine {
  id          String @id @default(cuid())
  nopaId      String
  nopa        Nopa   @relation(fields: [nopaId], references: [id], onDelete: Cascade)
  description String
  qtyWords    String? // sheet "Qty(WORDS)"
  uom         String?
  unitPrice   Int    @default(0)
  amount      Int    @default(0)
  sortOrder   Int    @default(0)

  @@index([nopaId])
}

// Company profile printed on document headers (tax invoice, NOPA, approval
// note, salary slip). Single row (id "company"), editable by Finance from
// /finance/company; src/lib/company.ts falls back to its static defaults when
// the row is absent, so no seed is required.
model CompanyProfile {
  id           String  @id @default("company")
  name         String
  addressLines String // multiline — one address line per line
  gstin        String?
  pan          String?
  cin          String?
  email        String?
  phone        String?
  bankName     String?
  accountNo    String?
  ifsc         String?

  updatedAt DateTime @updatedAt
  updatedBy String? // display name, loose string like the invoice audit fields
}

// Ledger-name mapping for the Tally XML export (/finance/tally). Singleton, like
// CompanyProfile; read via getTallySettings() which falls back to TALLY_DEFAULTS
// so a fresh DB needs no seed. All nullable → the fallback fills blanks.
model TallySettings {
  id               String  @id @default("tally")
  tallyCompanyName String? // Tally SVCURRENTCOMPANY (defaults to CompanyProfile.name)
  salesLedger      String? // default "Sales"
  gstLedger        String? // default "Output IGST"
  bankLedger       String? // default "Bank"
  roundOffLedger   String? // default "Round Off" (reserved; totals are exact today)

  updatedAt DateTime @updatedAt
  updatedBy String?
}
